rules_version = '2';

// Firestore rules for The Night Before (project kanji-study-5e39f).
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles + class-test progress (users/{uid}.testProgress).
    // Any signed-in user (Google or guest) can read profiles, so shared vocab
    // can show who added each word; only the owner can create or change theirs.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Shared vocabulary: anyone can read (it loads before sign-in);
    // signed-in users add words under their own id and delete only their own.
    match /sharedVocab/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.addedBy == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.addedBy == request.auth.uid;
      allow update: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
